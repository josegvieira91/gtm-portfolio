              "id": 19,
              "mapper": {
                "key": "{{executionId}}",
                "data": {
                  "digest": "CRM Hygiene Engine, nightly sweep of the lab portal\nRun started {{18.run_started}} America/Edmonton\n\nRepaired without asking anyone\n- company country rewritten to its canonical form: {{1.data.total}}\n- company domain stripped of its www. prefix: {{2.data.total}}\n- contact job title expanded and de-spaced: {{3.data.total}}\n- duplicate companies merged into the earliest record: {{length(6.data.results) - length(17.data.results)}}\n\nFlagged, not touched\n- contacts with no company: {{4.data.total}}\n- companies with no contact after the sweep: {{length(map(6.data.results; \"id\"; \"properties.num_associated_contacts\"; \"0\")) + length(map(17.data.results; \"id\")) - length(deduplicate(merge(map(6.data.results; \"id\"; \"properties.num_associated_contacts\"; \"0\"); map(17.data.results; \"id\"))))}}\n- contacts with no email, so no deterministic key to merge on: {{5.data.total}}\n\nCompany records in the portal: {{length(6.data.results)}} before the sweep, {{length(17.data.results)}} after",
                  "run_id": "{{executionId}}",
                  "actions": "country set to canonical: {{1.data.total}} ({{join(map(1.data.results; \"properties.domain\"); \", \")}})\ndomain set to canonical: {{2.data.total}} ({{join(map(2.data.results; \"properties.domain\"); \", \")}})\njob title set to canonical: {{3.data.total}} ({{join(map(3.data.results; \"properties.jobtitle\"); \" | \")}})\nmerged into earliest record: {{length(6.data.results) - length(17.data.results)}}\ncompany records in the portal: {{length(6.data.results)}} before, {{length(17.data.results)}} after\ndigest composed at epoch ms {{18.digest_composed}}",
                  "run_started": "{{18.run_started}}",
                  "review_items": "orphan contacts: {{join(map(4.data.results; \"properties.email\"); \", \")}}\ncompanies with no contact at scan time, some of which the sweep merged away as duplicates: {{join(map(6.data.results; \"properties.domain\"; \"properties.num_associated_contacts\"; \"0\"); \", \")}}\nno email, cannot match by rule: {{join(map(5.data.results; \"properties.lastname\"); \", \")}}",
                  "review_queued": "{{5.data.total}}",
                  "orphans_flagged": "{{4.data.total + length(map(6.data.results; \"id\"; \"properties.num_associated_contacts\"; \"0\")) + length(map(17.data.results; \"id\")) - length(deduplicate(merge(map(6.data.results; \"id\"; \"properties.num_associated_contacts\"; \"0\"); map(17.data.results; \"id\"))))}}",
                  "companies_merged": "{{length(6.data.results) - length(17.data.results)}}",

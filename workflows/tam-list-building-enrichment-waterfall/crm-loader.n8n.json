    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One line per company the loader touched, so the run is auditable without opening HubSpot.\nconst items = $input.all();\nconst created = items.filter(i => i.json.action === 'created').length;\nconst updated = items.filter(i => i.json.action === 'updated').length;\nreturn [{ json: { companies_written: items.length, created, updated, domains: items.map(i => i.json.domain) } }];"
      },

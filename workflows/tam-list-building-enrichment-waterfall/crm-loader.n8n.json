        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "CRM Loader Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -360,
        0
      ],
      "webhookId": "PLACEHOLDER",
      "credentials": {
        "httpHeaderAuth": {
          "name": "PLACEHOLDER_WEBHOOK_AUTH"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ \"https://sheets.googleapis.com/v4/spreadsheets/\" + $json.body.spreadsheet_id + \"/values/enriched_output\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Read Enriched Output",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -140,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "PLACEHOLDER_GOOGLE_SHEETS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turn the enriched_output sheet range into one item per qualifying company.\n// The waterfall already decided which rows are sales-ready; this node enforces\n// that decision at the CRM boundary and maps the free-text industry label to\n// HubSpot's fixed picklist, the same translation scripts/seed-data/lib/industry-map.mjs does.\nconst INDUSTRY_MAP = {\n  \"Software\": \"COMPUTER_SOFTWARE\",\n  \"Professional Services\": \"MANAGEMENT_CONSULTING\",\n  \"E-commerce\": \"RETAIL\",\n  \"Financial Services\": \"FINANCIAL_SERVICES\",\n  \"Healthcare Technology\": \"HOSPITAL_HEALTH_CARE\",\n  \"Manufacturing\": \"INDUSTRIAL_AUTOMATION\",\n  \"Logistics\": \"LOGISTICS_AND_SUPPLY_CHAIN\",\n  \"Marketing Services\": \"MARKETING_AND_ADVERTISING\",\n  \"Education Technology\": \"E_LEARNING\",\n  \"Real Estate Technology\": \"REAL_ESTATE\"\n};\nconst rows = $input.first().json.values || [];\nif (rows.length < 2) return [];\nconst header = rows[0];\nconst out = [];\nfor (const row of rows.slice(1)) {\n  const rec = {};\n  header.forEach((h, i) => { rec[h] = row[i] ?? ''; });\n  if (rec.enrichment_status !== 'enriched') continue;\n  if (String(rec.icp_fit).toUpperCase() !== 'TRUE') continue;\n  const properties = {\n    name: rec.company_name,\n    domain: rec.company_domain,\n    numberofemployees: rec.employee_count,\n    city: rec.hq_city,\n  };\n  const mapped = INDUSTRY_MAP[rec.industry];\n  if (mapped) properties.industry = mapped;\n  if (rec.company_linkedin_url) properties.linkedin_company_page = rec.company_linkedin_url;\n  out.push({ json: { domain: rec.company_domain, enrichment_source: rec.enrichment_source, properties } });\n}\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Gate On Enriched And ICP Fit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"filterGroups\": [ { \"filters\": [ { \"propertyName\": \"domain\", \"operator\": \"EQ\", \"value\": $json.domain } ] } ], \"properties\": [\"name\",\"domain\"], \"limit\": 1 } }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 400
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Search Company By Domain",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 2000,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        300,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "PLACEHOLDER_HUBSPOT"
        }
      }
    },
    {

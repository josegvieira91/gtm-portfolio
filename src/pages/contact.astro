---
// /contact. Cal.com inline embed, lazy-loaded through an
// IntersectionObserver so the third-party script never loads eagerly.
// min-height reserves the embed's box, so injecting it causes zero CLS.
//
// TODO at launch: the Cal.com event slug and the public e-mail address below
// are both set on launch day. `calLink` currently points at a live 30-minute
// event, and the address follows the site's own hello@ convention. Both are
// constants so there is exactly one line to change for each.
import BaseLayout from '../layouts/BaseLayout.astro';

const calLink = 'jose-vieira-snclfz/30min';
const contactEmail = 'hello@josevieira.dev';
---

<BaseLayout
  title="Contact - Jose Vieira"
  description="Book a call with Jose Vieira or reach out by email."
>
  <main class="blueprint-grid min-h-screen px-6 py-16">
    <div class="mx-auto max-w-2xl space-y-10">
      <header class="space-y-3">
        <p class="text-xs uppercase tracking-[0.25em] text-blueprint-dim">Contact</p>
        <h1 class="text-3xl font-bold text-blueprint-ink">Book a call</h1>
        <p class="text-sm leading-relaxed text-blueprint-dim">
          Pick a time below and it lands straight on my calendar. This same
          booking flow is Case 8 on this site, so this page is proof of its
          own kind.
        </p>
      </header>

      <section aria-label="Cal.com booking">
        <div id="cal-inline-embed" style="width:100%;min-height:600px">
          <noscript>
            <a href={`https://cal.com/${calLink}`} class="text-blueprint-line underline">
              Book a 30-minute call
            </a>
          </noscript>
        </div>
      </section>

      <p class="text-sm text-blueprint-dim">
        Prefer email? Reach me directly at{' '}
        <a class="text-blueprint-line underline" href={`mailto:${contactEmail}`}>
          {contactEmail}
        </a>.
      </p>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ calLink }}>
  // Cal.com's real embed.js, read directly off the shipped file, checks
  // `window.Cal.q` at its own top level and THROWS "Cal is not defined. This
  // shouldn't happen" if that stub isn't already present. It expects the
  // official bootstrap snippet to run first, not a bare <script src> tag
  // with an onload handler, which is what this file used to do and why the
  // widget never rendered. This IIFE is that stub: defining it is
  // synchronous, local, and costs zero network requests on its own. It only
  // queues calls into
  // `.q` until the real script (appended by the stub itself, on the FIRST
  // Cal(...) call) loads and "hydrates" it. That means the stub can be
  // defined unconditionally up front, while the actual Cal(...) invocations
  // below (the only things that trigger a real network fetch) stay
  // scroll-gated.
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  const target = document.getElementById('cal-inline-embed');
  if (target) {
    // A plain IntersectionObserver alone is not enough here. Its callback
    // reports the CURRENT intersection state the moment observe() runs,
    // with no scroll required, and on this page the embed div (short
    // header above it, 600px min-height) already clears the 10% threshold
    // inside a typical mobile viewport (412x823) with zero scrolling. That
    // fired an eager `app.cal.com` request on page load, which is exactly
    // what the lazy-load is there to prevent and what a Lighthouse run with
    // no scrolling catches. Gate loading on an actual scroll event having
    // happened at least once, not merely on intersection.
    let hasScrolled = false;
    let loaded = false;

    function loadEmbed() {
      if (loaded) return;
      loaded = true;
      observer.disconnect();
      window.removeEventListener('scroll', onScroll);
      // First real call to Cal(...) is what makes the stub above append the
      // actual <script src="https://app.cal.com/embed/embed.js"> tag.
      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', { elementOrSelector: '#cal-inline-embed', calLink });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (hasScrolled && entries[0].isIntersecting) loadEmbed();
      },
      { threshold: 0.1 }
    );

    function onScroll() {
      if (hasScrolled) return;
      hasScrolled = true;
      // The observer's own callback won't refire just because this flag
      // flipped (it only fires again on a threshold-crossing event), so if
      // the target was ALREADY intersecting before this first scroll, check
      // directly here rather than waiting for a crossing that may never come.
      const rect = target.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) loadEmbed();
    }

    observer.observe(target);
    window.addEventListener('scroll', onScroll, { passive: true, once: true });

    // CR-01 fix: scroll alone is not a reliable trigger. The BaseLayout
    // footer sits after a min-h-screen main, so every page technically
    // scrolls by ~90px. On a tall display the embed is fully visible
    // with no need to scroll, and a visitor can hover the empty box forever
    // without ever firing `scroll`. A `scrollHeight <= innerHeight` guard
    // therefore never arms (proven with a real-browser E2E at 1600x1401).
    // Arm the interaction fallback unconditionally instead: any deliberate
    // input is a "real visitor, not a Lighthouse/bot no-input run" signal.
    // Lighthouse dispatches no input events, so the no-interaction trace
    // stays free of app.cal.com requests. loadEmbed() is
    // idempotent, so the scroll path and this path can both fire safely.
    ['pointerdown', 'keydown', 'pointermove'].forEach((evt) =>
      window.addEventListener(evt, loadEmbed, { once: true, passive: true })
    );
  }
</script>

---
// SITE-07: /contact. Cal.com inline embed, lazy-loaded via IntersectionObserver
// (RESEARCH.md Code Example #6 / Pitfall 8: third-party script must never load
// eagerly). min-height reserves the embed's box so injection causes zero CLS.
//
// calLink: docs/lab-accounts.md documents the Cal.com account (username
// "josevieira" preferred) and a 30-minute "Intro call" event type. The real,
// gitignored lab-accounts.local.md records the actual username that landed
// (jose-vieira-snclfz, "josevieira" was taken) and flags the "Intro call"
// event's exact slug as unconfirmed ("Verification debt" section). Direct
// verification this session: https://cal.com/jose-vieira-snclfz/intro-call
// 404s; https://cal.com/jose-vieira-snclfz/30min (Cal.com's stock "30 Min
// Meeting" event) returns 200. calLink below points at that verified-live
// event rather than the plan's generic 'josevieira/intro' fallback, since a
// real reachable link beats an invented one — but it is still the STOCK event,
// not the intended "Intro call" branded one, so CAL_LINK_PLACEHOLDER stays.
import BaseLayout from '../layouts/BaseLayout.astro';

const calLink = 'jose-vieira-snclfz/30min';
// CONTACT_EMAIL_PLACEHOLDER: no confirmed public inbox for josevieira.dev found
// in PROJECT.md/design spec/lab docs. hello@josevieira.dev follows this
// project's own hello@ convention (see docs/lab-accounts.md's lab Gmail
// pattern) but is NOT a verified, routed mailbox. Confirm at 02-08 final gate.
const contactEmail = 'hello@josevieira.dev';
---

<!-- CAL_LINK_PLACEHOLDER: confirm the real "Intro call" event exists and get
     its exact slug at 02-08 final gate; swap calLink above if it differs
     from the stock jose-vieira-snclfz/30min event used here. -->
<BaseLayout
  title="Contact - Jose Vieira"
  description="Book a call with Jose Vieira or reach out by email."
>
  <main class="blueprint-grid min-h-screen px-6 py-16">
    <div class="mx-auto max-w-2xl space-y-10">
      <header class="space-y-3">
        <p class="text-xs uppercase tracking-[0.25em] text-blueprint-dim">Contact</p>
        <h1 class="text-3xl font-bold text-blueprint-ink">Book a call</h1>
        <p class="text-sm leading-relaxed text-blueprint-dim">
          Pick a time below and it lands straight on my calendar. This same
          booking flow is Case 8 on this site, so this page is proof of its
          own kind.
        </p>
      </header>

      <section aria-label="Cal.com booking">
        <div id="cal-inline-embed" style="width:100%;min-height:600px">
          <noscript>
            <a href={`https://cal.com/${calLink}`} class="text-blueprint-line underline">
              Book a 30-minute call
            </a>
          </noscript>
        </div>
      </section>

      <!-- CONTACT_EMAIL_PLACEHOLDER: unconfirmed mailbox, see note above -->
      <p class="text-sm text-blueprint-dim">
        Prefer email? Reach me directly at{' '}
        <a class="text-blueprint-line underline" href={`mailto:${contactEmail}`}>
          {contactEmail}
        </a>.
      </p>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ calLink }}>
  // 02-08 fix (Rule 1/2 — the widget never actually rendered before this):
  // Cal.com's real embed.js (verified directly against the shipped file)
  // checks `window.Cal.q` at its own top level and THROWS "Cal is not
  // defined. This shouldn't happen" if that stub isn't already present —
  // it expects the official bootstrap snippet to run first, not a bare
  // <script src> tag with an onload handler (the pattern this file had
  // before, copied from RESEARCH.md's Code Example #6, which omitted the
  // stub). This IIFE is that stub: defining it is synchronous, local, and
  // costs zero network requests on its own — it only queues calls into
  // `.q` until the real script (appended by the stub itself, on the FIRST
  // Cal(...) call) loads and "hydrates" it. That means the stub can be
  // defined unconditionally up front, while the actual Cal(...) invocations
  // below (the only things that trigger a real network fetch) stay
  // scroll-gated.
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  const target = document.getElementById('cal-inline-embed');
  if (target) {
    // A plain IntersectionObserver alone is not enough here. Its callback
    // reports the CURRENT intersection state the moment observe() runs,
    // with no scroll required — and on this page the embed div (short
    // header above it, 600px min-height) already clears the 10% threshold
    // inside a typical mobile viewport (412x823) with zero scrolling. That
    // fired an eager `app.cal.com` request on page load, exactly the bug
    // Pitfall 8 / the 02-08 Lighthouse no-scroll gate exists to catch. Gate
    // loading on an actual scroll event having happened at least once, not
    // merely on intersection.
    let hasScrolled = false;
    let loaded = false;

    function loadEmbed() {
      if (loaded) return;
      loaded = true;
      observer.disconnect();
      window.removeEventListener('scroll', onScroll);
      // First real call to Cal(...) is what makes the stub above append the
      // actual <script src="https://app.cal.com/embed/embed.js"> tag.
      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', { elementOrSelector: '#cal-inline-embed', calLink });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (hasScrolled && entries[0].isIntersecting) loadEmbed();
      },
      { threshold: 0.1 }
    );

    function onScroll() {
      if (hasScrolled) return;
      hasScrolled = true;
      // The observer's own callback won't refire just because this flag
      // flipped (it only fires again on a threshold-crossing event) — so if
      // the target was ALREADY intersecting before this first scroll, check
      // directly here rather than waiting for a crossing that may never come.
      const rect = target.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) loadEmbed();
    }

    observer.observe(target);
    window.addEventListener('scroll', onScroll, { passive: true, once: true });

    // CR-01 fix: a page whose content fits entirely inside the viewport can
    // never fire `scroll` (there's nothing to scroll), so `loadEmbed()` was
    // unreachable there and the visitor saw a permanently empty box. Any
    // deliberate interaction is an equally good "real visitor, not a
    // Lighthouse/bot no-scroll run" signal, and only needed when the
    // document genuinely doesn't scroll.
    function scheduleFallback() {
      if (document.documentElement.scrollHeight <= window.innerHeight) {
        ['pointerdown', 'keydown', 'pointermove'].forEach((evt) =>
          window.addEventListener(evt, loadEmbed, { once: true, passive: true })
        );
      }
    }
    // Re-check after layout settles (fonts/images can change scrollHeight)
    // and again on resize, since a viewport resize can flip a page between
    // scrollable and non-scrollable without a reload.
    window.addEventListener('load', scheduleFallback, { once: true });
    window.addEventListener('resize', scheduleFallback, { passive: true });
    scheduleFallback();
  }
</script>

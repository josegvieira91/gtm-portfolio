---
// src/components/home/MachineWall.astro
//
// The home machine wall ships all 10 catalog cards with real titles and
// tool tags, so the tool filter is testable against real data rather than
// stand-ins. Each card composes Schematic (variant="mini") over that case's
// diagram: 3-5 node placeholder skeletons for the cases still in build, the
// real diagram for the ones that are published. That content shape already
// satisfies SCHEMATIC_CONFIG.miniSchematic = 'skeleton', so nothing here
// switches on it directly.
//
// Mini-schematic draw trigger: mode="auto" on Schematic means the shared
// deferred controller (SchematicController.ts, unchanged by this plan)
// draws each mini once it nears the viewport (IntersectionObserver,
// 200px rootMargin) — this is the literal mechanism behind "the mini
// draws once the card scrolls into view" for touch devices. Because a
// card cannot physically be hovered before it is on screen, this same
// scroll-triggered draw already covers the hover-capable case too by the
// time a pointer can reach it; genuinely gating the draw itself behind
// `:hover` would require teaching the shared engine a third trigger mode
// (SchematicController.ts/timeline.ts), which is out of this task's
// scope (see SUMMARY Decisions). The hover affordance layer here is a
// real, CSS-only lift/glow micro-interaction on top of that scroll-drawn
// state. Touch behavior for hover-only affordances is left to the
// implementation.
import { getCollection } from 'astro:content';
import Schematic from '../schematic/Schematic.astro';
import { Icon } from 'astro-icon/components';
import { TOOL_ICONS } from '../../lib/schematic/tool-icons';
import { LOCAL_ICONS } from '../schematic/local-icons';

// Filter chips (content pass 2026-07-25): with the diversified catalog the
// chip set covers the three orchestrators, the two data/enrichment tools,
// the two CRMs, and the two AI providers by name — José's call: "AI" is
// not a tool, so the chips name Claude and OpenAI concretely. The filter is
// single-select plus All (SCHEMATIC_CONFIG.filterMode).
const FILTER_CHIPS: { id: string; label: string; match: string | null }[] = [
  { id: 'all', label: 'All', match: null },
  { id: 'n8n', label: 'n8n', match: 'n8n' },
  { id: 'make', label: 'Make', match: 'Make' },
  { id: 'zapier', label: 'Zapier', match: 'Zapier' },
  { id: 'clay', label: 'Clay', match: 'Clay' },
  { id: 'apollo', label: 'Apollo', match: 'Apollo' },
  { id: 'hubspot', label: 'HubSpot', match: 'HubSpot' },
  { id: 'salesforce', label: 'Salesforce', match: 'Salesforce' },
  { id: 'claude', label: 'Claude', match: 'Claude' },
  { id: 'openai', label: 'OpenAI', match: 'OpenAI' },
];

// Normalizes a case's raw `stack` display name ("Google Sheets", "Cal.com")
// to a tool-icons.ts key ("googlesheets", "calcom") — same rule as
// StackBadges.astro. Tools outside the mapped icon set render no badge,
// the same rule the diagram node tools follow.
function toolKey(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]/g, '');
}

const localIconInline = (path: string): string =>
  (LOCAL_ICONS[path] ?? '').replace('<svg', '<svg width="100%" height="100%"');

const [caseEntries, diagramEntries] = await Promise.all([
  getCollection('cases'),
  getCollection('diagrams'),
]);

const diagramsById = new Map(diagramEntries.map((entry) => [entry.data.id, entry]));

const cases = caseEntries
  .slice()
  .sort((a, b) => (a.data.diagramId ?? a.id).localeCompare(b.data.diagramId ?? b.id));
---

<section class="blueprint-grid px-6 py-20" aria-labelledby="wall-heading">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 flex flex-col gap-4">
      <h2 id="wall-heading" class="text-xs uppercase tracking-[0.25em] text-blueprint-dim">
        The machines
      </h2>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by tool">
        {FILTER_CHIPS.map((chip) => (
          <button
            type="button"
            data-filter-chip
            data-filter-match={chip.match ?? ''}
            aria-pressed={chip.id === 'all'}
            class="rounded-full border px-4 py-1.5 text-xs uppercase tracking-wide transition-colors"
          >
            {chip.label}
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-wall-grid>
      {cases.map((caseEntry) => {
        const baseDiagramId = caseEntry.data.diagramId ?? caseEntry.id;
        // A case with a real, rich 8-node diagram cannot reuse it verbatim
        // at mini-card scale: 8 labels crammed into the same width the
        // generic 4-node placeholders use, and the labels overlapped
        // (measured and screenshotted: "EB FORM N8N WEBHOOKENRICHMENT..."
        // running together). The mini-schematics are generic placeholders
        // across the whole wall anyway, not per-case-accurate, so a
        // dedicated `${id}-mini` diagram (falls
        // back to the main diagram when none exists, i.e. for all 9
        // already-simple placeholder cases, unchanged) keeps every card's
        // mini honestly simple, and generalizes to any later case whose
        // real diagram is too dense for card scale rather than being a
        // one-off.
        const diagramEntry = diagramsById.get(`${baseDiagramId}-mini`) ?? diagramsById.get(baseDiagramId);
        if (!diagramEntry) {
          throw new Error(`MachineWall: no diagram found for case "${caseEntry.id}"`);
        }
        const toolKeys = caseEntry.data.stack
          .map((tool) => toolKey(tool))
          .filter((key) => Boolean(TOOL_ICONS[key]));

        // A case still in build keeps its slot, its diagram and its tool
        // tags, so the wall holds its shape and the filter still counts it.
        // What it does not get is a link, because it has no page yet. The
        // card wrapper switches from <a> to <div> and the hover affordances
        // come off with it, so nothing invites a click that goes nowhere.
        const inBuild = caseEntry.data.draft;
        const CardWrapper = inBuild ? 'div' : 'a';

        return (
          <article
            data-wall-card
            data-tools={caseEntry.data.stack.join('|')}
            class:list={[
              'group overflow-hidden rounded-lg border border-blueprint-line/25 bg-blueprint-surface transition-[translate,scale,opacity] duration-300',
              !inBuild && 'hover:-translate-y-1 hover:border-blueprint-line/60',
            ]}
          >
            <CardWrapper href={inBuild ? undefined : `/cases/${caseEntry.data.slug}/`} class="block p-5">
              <div
                class:list={[
                  'mb-4 aspect-[4/3] overflow-hidden rounded border border-blueprint-line/15 bg-blueprint-bg/40 p-3 transition-shadow duration-300',
                  !inBuild && 'group-hover:shadow-[0_0_24px_-6px_var(--color-blueprint-line)]',
                ]}
              >
                <Schematic
                  diagram={diagramEntry.data}
                  variant="mini"
                  mode="auto"
                  id={`wall-${caseEntry.data.slug}`}
                />
              </div>
              <p class="flex items-center justify-between gap-2 text-[10px] uppercase tracking-[0.2em] text-blueprint-dim">
                <span>{caseEntry.data.category}</span>
                {inBuild && (
                  <span class="shrink-0 rounded-full border border-blueprint-line/40 px-2 py-0.5 text-[9px] tracking-[0.15em] text-blueprint-line">
                    In build
                  </span>
                )}
              </p>
              <h3 class="mt-1 text-base font-semibold text-blueprint-ink">{caseEntry.data.title}</h3>
              {caseEntry.data.heroMetric && (
                <p class="mt-1 text-xs text-blueprint-line">{caseEntry.data.heroMetric}</p>
              )}
              <div class="mt-3 flex flex-wrap gap-1.5">
                {toolKeys.map((key) => {
                  const icon = TOOL_ICONS[key];
                  return (
                    <span
                      class="flex h-6 w-6 items-center justify-center rounded bg-blueprint-ink/90 p-1"
                      title={key}
                    >
                      {icon.slug ? (
                        <Icon name={`simple-icons:${icon.slug}`} width={14} height={14} style={`color:${icon.hex}`} />
                      ) : (
                        <span style={`color:${icon.hex}`} set:html={localIconInline(icon.local ?? '')} />
                      )}
                    </span>
                  );
                })}
              </div>
            </CardWrapper>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* The filter chip's look used to have three sources of truth
     -- an SSR class:list ternary, plus two class-name arrays the click
     handler toggled by hand -- that had to stay in sync manually. The
     unselected chip's SSR markup carried a hover-only Tailwind utility the
     click handler's arrays never removed, so an active chip's border
     reverted to the unselected look on hover; the "All" chip, SSR'd
     without that same utility, then behaved differently from its siblings
     once deselected and reselected. `aria-pressed`, which the chip needs
     anyway, is now the single source of truth: both looks are pure
     attribute-selector CSS below, and the click handler only ever toggles
     the attribute. */
  [data-filter-chip][aria-pressed="true"] {
    border-color: var(--color-blueprint-line);
    background-color: var(--color-blueprint-line);
    color: var(--color-blueprint-bg);
  }

  [data-filter-chip][aria-pressed="false"] {
    border-color: color-mix(in oklab, var(--color-blueprint-line) 30%, transparent);
    color: var(--color-blueprint-dim);
  }

  /* Scoped to aria-pressed="false" only -- an active chip must never revert
     on hover, which is the exact bug described above. */
  [data-filter-chip][aria-pressed="false"]:hover {
    border-color: color-mix(in oklab, var(--color-blueprint-line) 60%, transparent);
  }
</style>

<script>
  // Filter: single-select plus All. A card
  // matches when its raw `stack` (data-tools, pipe-separated) contains the
  // chip's exact match string. Non-matching cards get a transform/opacity
  // micro-transition rather than being removed from the grid outright.
  const chipButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-chip]');
  const cards = document.querySelectorAll<HTMLElement>('[data-wall-card]');

  function applyFilter(match: string | null): void {
    cards.forEach((card) => {
      const tools = (card.getAttribute('data-tools') ?? '').split('|');
      const visible = !match || tools.includes(match);
      card.classList.toggle('opacity-20', !visible);
      card.classList.toggle('scale-95', !visible);
      card.classList.toggle('pointer-events-none', !visible);
      card.toggleAttribute('data-filtered-out', !visible);
      // None of the classes above remove the card from the
      // accessibility tree or the tab order (pointer-events-none blocks the
      // mouse only) -- a keyboard/screen-reader user still reached every
      // filtered-out card. `inert` removes both.
      card.toggleAttribute('inert', !visible);
    });
  }

  chipButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      chipButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      applyFilter(btn.getAttribute('data-filter-match') || null);
    });
  });
</script>

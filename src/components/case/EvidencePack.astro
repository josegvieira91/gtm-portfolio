---
// src/components/case/EvidencePack.astro
//
// D-15 (2026-08-25): one standard for all 10 cases, no video anywhere. Every
// case ships an evidence pack of 2-3 sanitized execution screenshots plus a
// download link to the sanitized workflow JSON. Replaces the earlier D-14
// carve-out where Case 1 kept a recorded video via RecordingPlayer -- that
// component and the video/poster frontmatter fields are gone. A case with
// no evidence captured yet still renders the original "Evidence coming
// soon." placeholder so nothing regresses before a case is captured. Zero
// client JS in this component.
import { Image } from 'astro:assets';
import { repoFileUrl } from '../../lib/site';

interface EvidenceItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  evidence?: EvidenceItem[];
  exportPath?: string;
}

const { evidence, exportPath } = Astro.props;
---

<div class="mx-auto max-w-3xl">
  {evidence && evidence.length > 0 ? (
    <div class="space-y-6">
      {evidence.map((item) => (
        <figure class="overflow-hidden rounded-lg border border-blueprint-line/30 bg-blueprint-surface">
          <Image src={item.src} alt={item.alt} class="block w-full" />
          <figcaption class="border-t border-blueprint-line/20 px-4 py-3 text-center text-xs text-blueprint-dim">
            {item.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div class="rounded-lg border border-dashed border-blueprint-line/30 bg-blueprint-surface p-10 text-center text-sm text-blueprint-dim">
      Evidence coming soon.
    </div>
  )}

  {exportPath && (
    <p class="mt-6 text-center text-sm">
      <a
        href={repoFileUrl(exportPath)}
        rel="noopener"
        target="_blank"
        class="text-blueprint-line underline hover:text-blueprint-ink"
      >
        Download the workflow JSON
      </a>
    </p>
  )}
</div>

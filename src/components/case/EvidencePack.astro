---
// src/components/case/EvidencePack.astro
//
// One standard for all 10 cases, with no video anywhere. Every case ships an
// evidence pack of 1-3 sanitized execution screenshots plus a download link
// to the sanitized workflow JSON. This replaces an earlier carve-out where
// Case 1 kept a recorded video via RecordingPlayer; that component and the
// video and poster frontmatter fields are gone. A case with
// no evidence captured yet still renders the original "Evidence coming
// soon." placeholder so nothing regresses before a case is captured.
//
// The pack opens with the ExecutionReplay when a
// case has one (src/content/replays/<caseSlug>.json) -- the HTML replay
// explains the run, the still(s) below are the receipt, the JSON link
// lets a reviewer open the thing. Cases with no replay entry yet just
// skip straight to the stills, same as before.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { repoFileUrl } from '../../lib/site';
import ExecutionReplay from './ExecutionReplay.astro';

interface EvidenceItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  evidence?: EvidenceItem[];
  exportPath?: string;
  caseSlug?: string;
}

const { evidence, exportPath, caseSlug } = Astro.props;

const replays = caseSlug
  ? await getCollection('replays', (entry) => entry.data.caseSlug === caseSlug)
  : [];
const replay = replays[0]?.data;
---

<div class="mx-auto max-w-3xl">
  {replay && <ExecutionReplay replay={replay} />}

  {evidence && evidence.length > 0 ? (
    <div class="space-y-6">
      {evidence.map((item) => (
        <figure class="overflow-hidden rounded-lg border border-blueprint-line/30 bg-blueprint-surface">
          {/* Full-size still opens in a new tab: a 45-node canvas cannot be
              legible at column width, so the inline image is the overview and
              the click is the zoom. */}
          <a href={item.src.src} target="_blank" rel="noopener" title="Open full size">
            <Image src={item.src} alt={item.alt} class="block w-full" />
          </a>
          <figcaption class="border-t border-blueprint-line/20 px-4 py-3 text-center text-xs text-blueprint-dim">
            {item.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div class="rounded-lg border border-dashed border-blueprint-line/30 bg-blueprint-surface p-10 text-center text-sm text-blueprint-dim">
      Evidence coming soon.
    </div>
  )}

  {exportPath && (
    <p class="mt-6 text-center text-sm">
      <a
        href={repoFileUrl(exportPath)}
        rel="noopener"
        target="_blank"
        class="text-blueprint-line underline hover:text-blueprint-ink"
      >
        View the workflow JSON on GitHub
      </a>
    </p>
  )}
</div>

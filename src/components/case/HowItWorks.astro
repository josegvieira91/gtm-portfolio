---
// src/components/case/HowItWorks.astro
//
// Part 3 of the 7-part case anatomy: a styled wrapper for the rendered MDX
// body, which holds the problem framing and the "How it works" prose. Pure
// static, typography only, blueprint tokens, no client JS. No
// @tailwindcss/typography plugin is installed (not in the audited
// dependency set), so the heading/paragraph/strong styling below is
// hand-rolled against the same --color-blueprint-* tokens every other
// component consumes, scoped to this component via Astro's :global()
// (the MDX body's rendered HTML lives inside <slot />, outside this
// component's own template, so plain scoped selectors wouldn't reach it).
---

<section class="how-it-works px-6 py-16" aria-label="How it works">
  <div class="mx-auto max-w-2xl">
    <slot />
  </div>
</section>

<style>
  .how-it-works :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-blueprint-dim);
  }
  .how-it-works :global(h2:first-child) {
    margin-top: 0;
  }
  .how-it-works :global(p) {
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-blueprint-ink);
  }
  .how-it-works :global(strong) {
    color: var(--color-blueprint-line);
    font-weight: 600;
  }
  .how-it-works :global(a) {
    color: var(--color-blueprint-line);
    text-decoration: underline;
  }
  .how-it-works :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-blueprint-line);
  }
  .how-it-works :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .how-it-works :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .how-it-works :global(li) {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-blueprint-ink);
  }
  .how-it-works :global(li::marker) {
    color: var(--color-blueprint-dim);
  }
  .how-it-works :global(code) {
    background: var(--color-blueprint-surface);
    color: var(--color-blueprint-accent);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .how-it-works :global(pre) {
    background: var(--color-blueprint-surface);
    border: 1px solid color-mix(in oklab, var(--color-blueprint-line) 30%, transparent);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  .how-it-works :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: 1em;
  }
  .how-it-works :global(blockquote) {
    border-left: 2px solid color-mix(in oklab, var(--color-blueprint-line) 50%, transparent);
    padding-left: 1rem;
    color: var(--color-blueprint-dim);
    font-style: normal;
    margin-bottom: 1.25rem;
  }
  .how-it-works :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin-bottom: 1.25rem;
  }
</style>

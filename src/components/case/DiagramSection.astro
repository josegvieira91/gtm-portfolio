---
// src/components/case/DiagramSection.astro
//
// Scrollytelling section: desktop pins the diagram at ~60% width on
// the left while engineering callouts scroll past it on the right, each
// callout lighting its node as the corresponding step activates. Mobile
// behavior is exactly ONE config value (SCHEMATIC_CONFIG.mobilePin), so
// what real-device testing decides is a config flip and a rebuild, never a
// template rework. Composes Schematic.astro and never re-implements
// SVG rendering. The actual pinning/scrubbing is entirely GSAP's job at
// runtime (timeline.ts, non-reduced-motion only); this component only
// lays out the SSR final-state structure GSAP will animate.
import Schematic from '../schematic/Schematic.astro';
import { SCHEMATIC_CONFIG } from '../../lib/schematic/config';
import type { Diagram, DiagramStep } from '../../lib/schematic/types';
import ScrollHint from './ScrollHint.astro';

interface Props {
  diagram: Diagram;
  id: string;
  /** Case title, passed through to Schematic as its accessible name. */
  label?: string;
}

const { diagram, id, label } = Astro.props;
const mobilePin = SCHEMATIC_CONFIG.mobilePin === 'pin';
const steps: DiagramStep[] = diagram.steps.filter((step) => step.callout);
---

{/* Mobile-only. When GSAP pins this section (ScrollTrigger's
    default `start: "top top"`), it locks to the viewport's literal y=0,
    exactly where iOS's Dynamic Island and status bar sit. `env(safe-area-inset-top)`
    (needs `viewport-fit=cover` on the viewport meta, set in BaseLayout.astro)
    pushes the pinned content below that safe area on notched devices and
    resolves to 0 everywhere else, so this is a no-op on non-notched phones.
    `md:pt-0` keeps desktop pin behavior byte-identical, so nothing above
    the md breakpoint changes. */}
{/* Cases whose diagrams define no callout steps yet (the catalog
    placeholders) get a centered single-column stage: the 60/40
    scrollytelling grid with an EMPTY right rail reads as a broken,
    off-center page, not as a layout. The scrub-draw animation still runs,
    with the same data-pin-section boundary and the same Schematic mount.
    There is just no
    callout column to scroll past. This branch disappears naturally as each
    case gains real callout content. */}
{steps.length === 0 ? (
  <section id={id} data-pin-section class="px-6 py-16 pt-[env(safe-area-inset-top)] md:py-24">
    <div class="mx-auto max-w-4xl">
      <ScrollHint />
      <Schematic diagram={diagram} variant="full" mode="scroll" id={`${id}-schematic`} label={label} />
    </div>
  </section>
) : (
<section
  id={id}
  data-pin-section
  class="grid gap-6 pt-[env(safe-area-inset-top)] md:grid-cols-[60%_1fr] md:gap-8 md:pt-0"
>
  {/* Horizontal mobile clip: CSS Grid items default to
      `min-width: auto`, which refuses to shrink below the child SVG's own
      intrinsic content size. On a narrow viewport this held the diagram at
      its full ~880px-wide intrinsic size and clipped both edges instead of
      letting `w-full` (on the SVG itself) actually scale it down. `min-w-0`
      removes that floor so the SVG's own width:100% can shrink to the real
      track width; harmless on desktop since the 60% track is already wider
      than the SVG's natural size there (no visible change confirmed).

      Desktop layout: the pinned section's own
      grid row stretches to match its tallest sibling (the callout column's
      `gap-[60vh]` stack, several viewport-heights tall), and GSAP's `pin:true`
      with a fixed `end` distance decoupled from that real DOM height
      (see timeline.ts) released the pin early, mid-scroll, producing the
      clipped/jumping look. Native `md:sticky md:top-0` replaces the GSAP
      pin for desktop only: it sticks to the viewport top for exactly as
      long as its (already-correctly-sized) grid cell is scrolling through,
      by construction, with no separate distance to keep in sync. Mobile pin
      (already spike-verified smooth) is untouched: `sticky` only applies
      at md+.

      `md:self-start` is required alongside `sticky` here: CSS Grid's
      default `align-items: stretch` was stretching THIS item's own box to
      match the taller callout-column sibling's row height (verified via
      real headless measurement: the wrapper's own rect was 3130px tall,
      identical to the row), sticky has nothing to visually "stick within"
      when the sticky element's own box already spans the entire
      scrollable distance. `self-start` keeps this item at its natural
      (short, SVG-sized) height while the grid ROW itself stays tall
      (still governed by the callout column), which is exactly the
      short-child-inside-tall-area relationship sticky positioning needs.
      Re-verified after adding this: wrapper top stays pinned at 0px across
      the full scroll range instead of tracking scrollY 1:1. */}
  {/* Full-width row above both columns, so the hint sits centered on the
      page rather than inside the diagram's 60% column, where a wide
      monitor pushed it off-center and made it easy to miss. */}
  <div class="md:col-span-2">
    <ScrollHint />
  </div>

  <div class="min-w-0 md:sticky md:top-0 md:self-start md:py-16">
    <Schematic diagram={diagram} variant="full" mode="scroll" id={`${id}-schematic`} label={label} />
  </div>

  {/* Desktop (md+): callouts scroll past the pinned diagram, one block per step */}
  <div class="hidden flex-col gap-[60vh] py-[30vh] md:flex">
    {steps.map((step) => (
      <div data-step-callout={step.id} class="rounded-lg border border-blueprint-line/30 bg-blueprint-surface p-6">
        <p class="font-mono text-sm text-blueprint-ink">{step.callout?.text}</p>
      </div>
    ))}
  </div>

  {/* Mobile (below md): exactly one of the two layouts, picked at build time */}
  {mobilePin ? (
    <div class="flex flex-col gap-3 md:hidden" data-mobile-layout="pin">
      {steps.map((step) => (
        <div
          data-step-callout={step.id}
          class="rounded-lg border border-blueprint-line/40 bg-blueprint-surface/95 p-3 text-xs shadow-lg backdrop-blur"
        >
          <p class="font-mono text-blueprint-ink">{step.callout?.text}</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="flex flex-col gap-4 md:hidden" data-mobile-layout="unpinned">
      {steps.map((step) => (
        <div data-step-callout={step.id} class="rounded-lg border border-blueprint-line/30 bg-blueprint-surface p-4">
          <p class="font-mono text-xs text-blueprint-ink">{step.callout?.text}</p>
        </div>
      ))}
    </div>
  )}
</section>
)}

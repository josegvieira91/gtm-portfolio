---
// src/components/schematic/Schematic.astro
//
// The ONE component that SSRs any diagram — full case diagram or the
// compact mini variant used by the home machine wall / card hover — in
// its FINAL, fully-drawn state (SITE-03). Never an "undrawn" starting
// state: full opacity, drawSVG untouched (Pattern 2, non-negotiable). The
// client controller (SchematicController.ts) is the only thing allowed to
// move it backward, and only after gsap.matchMedia() confirms
// prefers-reduced-motion is NOT set.
//
// T-02-08 (content injection via the embedded diagram JSON): data is
// owner-authored and zod-validated at build time; the payload is
// serialized with JSON.stringify and `</script` sequences are explicitly
// escaped before being written via `set:html`. Astro's plain `{expr}`
// child interpolation does NOT evaluate inside inline <script> tags —
// verified directly against this component's own build output, where it
// rendered as the literal text "{diagramPayload}" instead of the JSON —
// so `set:html` (Astro's own directive, not a hand-rolled string-concat
// workaround) is the correct mechanism here, with the explicit escape
// above as the mitigation for the risk that directive normally carries.
import { computeLayout, viewBoxFor } from '../../lib/schematic/layout';
import type { Diagram, DiagramEdge, DiagramNode } from '../../lib/schematic/types';
import SchematicNode from './SchematicNode.astro';
import SchematicEdge from './SchematicEdge.astro';

interface Props {
  diagram: Diagram;
  variant: 'full' | 'mini';
  mode?: 'scroll' | 'auto';
  id: string;
  /** Accessible name for the 'full' variant only (WR-08). Falls back to a
   * readable `${diagram.id} schematic` string when omitted -- never used for
   * 'mini', which is always aria-hidden (see below). */
  label?: string;
}

const { diagram, variant, mode = 'scroll', id, label } = Astro.props;

// Full: generous grid for the pinned case-page diagram. Mini: compact grid
// for the home machine wall / card hover mini-variants (D-10).
const LAYOUT =
  variant === 'full'
    ? { stageWidth: 160, laneHeight: 100, padding: 40, nodeWidth: 120, nodeHeight: 52 }
    : { stageWidth: 56, laneHeight: 36, padding: 16, nodeWidth: 40, nodeHeight: 18 };

const positions = computeLayout(diagram, LAYOUT);
const viewBox = viewBoxFor(diagram, positions, LAYOUT);

// SSR final-state resting spot for the packet marker (D-08): the last node
// of the last step that has a packetPath, falling back to the diagram's
// final node when no step defines one. Client JS hides it (opacity 0)
// before scrubbing it forward step by step.
function restingNodeId(): string | undefined {
  for (let i = diagram.steps.length - 1; i >= 0; i -= 1) {
    const path = diagram.steps[i].packetPath;
    if (path?.length) return path[path.length - 1];
  }
  return diagram.nodes.at(-1)?.id;
}
const restPos = positions[restingNodeId() ?? ''];

// IN-13 fix: `</script` escaping is the documented and sufficient mitigation
// for this set:html payload, and the data is zod-validated owner-authored
// content, so there is no exploitable path today -- but JSON.stringify also
// leaves `<`, U+2028 and U+2029 raw, and escaping `<` alone subsumes the
// `</script` case entirely. Belt-and-braces; all three round-trip through
// JSON.parse identically. U+2028/U+2029 are matched via their `\uXXXX` regex
// escape (a LineTerminator character cannot appear raw inside a regex
// literal's pattern per the ECMAScript grammar).
const diagramPayload = JSON.stringify({ diagram, positions, layout: LAYOUT })
  .replace(/<\/script/gi, '<\\/script')
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

{/* 02-07 Gate 2 round-3 fix (machine wall mini-schematics: cut nodes,
    orphaned edges, huge empty gaps below content): the 10 diagrams' own
    viewBox aspect ratios range from 1.19:1 to 6.25:1 (measured directly
    from each case's JSON) — nowhere close to a single fixed ratio, so
    `w-full h-auto` (deriving height purely from the SVG's OWN aspect,
    ignoring the card panel's actual box) either left the panel mostly
    empty below a too-short diagram or let a too-tall one overflow past
    `overflow-hidden` and get clipped/orphaned mid-edge. `variant="mini"`
    now fills BOTH axes of its panel (`h-full w-full` on the root div and
    the svg) and relies on the SVG spec's own default
    `preserveAspectRatio="xMidYMid meet"` (unset here = default) to scale
    the viewBox content to fit inside that box on both axes, centered,
    with letterboxing rather than cropping or gapping — the standard,
    zero-JS way to make an SVG with an unknown/variable aspect ratio
    always fit a fixed container. `variant="full"` (case pages, hero) is
    untouched: it still wants `h-auto` so a single wide diagram scales by
    width alone, matching the desktop sticky/mobile pin fixes already
    verified for that path. */}
<div data-schematic-root data-mode={mode} data-variant={variant} id={id} class:list={[variant === 'mini' && 'h-full']}>
  {/* overflow-hidden is load-bearing, not cosmetic: Chrome clips painted
      content at the svg viewport by default, WebKit paints content that
      leaks past the viewBox (02-07 Gate 2). The viewBox now covers true
      extents, so nothing should leak — this pins both engines to the same
      clipping behavior if an estimate is ever off. */}
  <svg
    viewBox={viewBox}
    class:list={['w-full', 'overflow-hidden', variant === 'mini' ? 'h-full' : 'h-auto']}
    data-schematic-svg
    {...variant === 'mini'
      ? { 'aria-hidden': 'true', focusable: 'false' }
      : { role: 'img', 'aria-label': label ?? `${diagram.id} schematic` }}
  >
    {diagram.edges.map((edge: DiagramEdge) => (
      <SchematicEdge edge={edge} fromPos={positions[edge.from]} toPos={positions[edge.to]} />
    ))}
    {/* Paint order is load-bearing: the packet sits ABOVE edges (it travels
        along them) but BELOW nodes, so on arrival it docks INTO the unit —
        the node's opaque body occludes it — instead of parking on top of
        the tool's logo chip (Gate 2 follow-up: the packet's settle position
        is a node CENTER, exactly where SchematicNode paints the logo). */}
    {restPos && (
      <circle data-packet cx={restPos.x} cy={restPos.y} r={Math.max(3, LAYOUT.nodeHeight * 0.08)} class="fill-blueprint-accent" />
    )}
    {diagram.nodes.map((node: DiagramNode) => (
      <SchematicNode node={node} pos={positions[node.id]} width={LAYOUT.nodeWidth} height={LAYOUT.nodeHeight} />
    ))}
  </svg>
  <script type="application/json" data-diagram set:html={diagramPayload} />
</div>

<script>
  import { initSchematics } from './SchematicController';
  initSchematics();
</script>

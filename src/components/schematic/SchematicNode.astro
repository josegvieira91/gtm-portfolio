---
// src/components/schematic/SchematicNode.astro
//
// Renders one diagram node as an SSR-final-state SVG group — full opacity,
// no scale/offset (Pattern 2: only the client controller ever moves this
// backward to an undrawn start, and only post reduced-motion check).
// Shape geometry follows circuit-schematic convention by node `kind`:
// trigger = rounded rect with an input notch, process = rounded rect,
// store = cylinder-ish rect (elliptical cap), output = chevron rect.
// Two visual treatments switch on SCHEMATIC_CONFIG.nodeStyle (GATE 1,
// D-05b): 'line-art' = geometry + label only, no icon glyph; 'logo' =
// same geometry plus the tool's real brand-colored Simple Icons glyph on
// a light chip (the winning Gate 1 treatment; Pitfall 5: real brand hex,
// not the cyan accent). Tools with no Simple Icons entry (Pitfall 4:
// Clay, Apollo, Instantly) fall back to hand-drawn glyphs resolved
// through LOCAL_ICONS (local-icons.ts), inlined via Vite ?raw imports so
// they need no public/ asset path.
import { Icon } from 'astro-icon/components';
import { SCHEMATIC_CONFIG } from '../../lib/schematic/config';
import { TOOL_ICONS } from '../../lib/schematic/tool-icons';
import type { DiagramNode, NodePosition } from '../../lib/schematic/types';
import { LOCAL_ICONS } from './local-icons';

interface Props {
  node: DiagramNode;
  pos: NodePosition;
  width: number;
  height: number;
}

const { node, pos, width: w, height: h } = Astro.props;
const x = pos.x - w / 2;
const y = pos.y - h / 2;
const r = Math.min(10, h * 0.25);
const notch = h * 0.28;

function shapePath(kind: DiagramNode['kind']): string {
  switch (kind) {
    case 'trigger':
      // Rounded rect with an input notch on the left edge.
      return `M${x + notch},${y} L${x + w - r},${y} Q${x + w},${y} ${x + w},${y + r} L${x + w},${y + h - r} Q${x + w},${y + h} ${x + w - r},${y + h} L${x + notch},${y + h} L${x},${y + h / 2} Z`;
    case 'output':
      // Chevron rect: right edge cut to a point.
      return `M${x + r},${y} L${x + w - notch},${y} L${x + w},${y + h / 2} L${x + w - notch},${y + h} L${x + r},${y + h} Q${x},${y + h} ${x},${y + h - r} L${x},${y + r} Q${x},${y} ${x + r},${y} Z`;
    case 'store': {
      // Cylinder-ish rect: elliptical top/bottom caps.
      const ry = h * 0.2;
      return `M${x},${y + ry} A${w / 2},${ry} 0 0 1 ${x + w},${y + ry} L${x + w},${y + h - ry} A${w / 2},${ry} 0 0 1 ${x},${y + h - ry} Z`;
    }
    case 'process':
    default:
      return `M${x + r},${y} L${x + w - r},${y} Q${x + w},${y} ${x + w},${y + r} L${x + w},${y + h - r} Q${x + w},${y + h} ${x + w - r},${y + h} L${x + r},${y + h} Q${x},${y + h} ${x},${y + h - r} L${x},${y + r} Q${x},${y} ${x + r},${y} Z`;
  }
}

const path = shapePath(node.kind);
const isLogo = SCHEMATIC_CONFIG.nodeStyle === 'logo';
const icon = TOOL_ICONS[node.tool];
const iconSize = Math.min(w, h) * 0.42;
const chipSize = iconSize + 4;
const labelY = y + h + 14;

// Inline the hand-drawn glyph with explicit positioning attributes
// injected into its root <svg> tag (avoids nested-viewport auto-sizing
// ambiguity from a bare `<svg>` with no width/height).
const localIconPositioned = icon?.local
  ? (LOCAL_ICONS[icon.local] ?? '').replace(
      '<svg',
      `<svg x="${pos.x - iconSize / 2}" y="${pos.y - iconSize / 2}" width="${iconSize}" height="${iconSize}" style="color:${icon.hex}"`
    )
  : '';
---

<g data-node-id={node.id} data-kind={node.kind} data-cx={pos.x} data-cy={pos.y}>
  <path
    d={path}
    class="fill-blueprint-surface stroke-blueprint-line"
    stroke-width="1.5"
    vector-effect="non-scaling-stroke"
  />
  {node.kind === 'store' && (
    <ellipse
      cx={pos.x}
      cy={y + h * 0.2}
      rx={w / 2}
      ry={h * 0.2}
      class="fill-none stroke-blueprint-line"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
    />
  )}
  {isLogo && icon && (
    <>
      <rect
        x={pos.x - chipSize / 2}
        y={pos.y - chipSize / 2}
        width={chipSize}
        height={chipSize}
        rx={3}
        class="fill-blueprint-ink/90"
      />
      {icon.slug ? (
        <Icon
          name={`simple-icons:${icon.slug}`}
          x={pos.x - iconSize / 2}
          y={pos.y - iconSize / 2}
          width={iconSize}
          height={iconSize}
          style={`color:${icon.hex}`}
        />
      ) : (
        <Fragment set:html={localIconPositioned} />
      )}
    </>
  )}
  <text
    x={pos.x}
    y={labelY}
    text-anchor="middle"
    class="fill-blueprint-dim font-mono text-[9px] uppercase tracking-wide"
  >
    {node.label}
  </text>
</g>

---
// Single source of truth for head boilerplate: noindex meta (D-11), viewport,
// charset, global.css (fonts + cyanotype tokens). Every page wraps this layout.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-blueprint-bg font-mono text-blueprint-ink">
    <slot />
    {/* WR-11 fix: the home page (this site's entire entry point) had no way
        to reach /about or /contact without opening a case page first, and
        /about was unreachable from anywhere. A quiet footer, not a header,
        keeps every page one click from every other without competing with
        the blueprint hero. */}
    <footer class="border-t border-blueprint-line/20 px-6 py-8 text-center text-xs uppercase tracking-[0.2em] text-blueprint-dim">
      <nav aria-label="Footer">
        <a href="/" class="hover:text-blueprint-line">Work</a>
        <span aria-hidden="true"> &middot; </span>
        <a href="/about/" class="hover:text-blueprint-line">About</a>
        <span aria-hidden="true"> &middot; </span>
        <a href="/contact/" class="hover:text-blueprint-line">Contact</a>
      </nav>
    </footer>
  </body>
</html>

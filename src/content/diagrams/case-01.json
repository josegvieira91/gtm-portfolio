{
  "id": "case-01",
  "nodes": [
    { "id": "form", "label": "Web Form", "stage": 0, "lane": 1, "kind": "trigger", "tool": "n8n" },
    { "id": "webhook", "label": "n8n Webhook", "stage": 1, "lane": 1, "kind": "process", "tool": "n8n" },
    { "id": "raw", "label": "Raw Payload Log", "stage": 2, "lane": 0, "kind": "store", "tool": "postgres" },
    { "id": "enrich", "label": "Enrichment", "stage": 2, "lane": 1, "kind": "process", "tool": "n8n" },
    { "id": "score", "label": "Lead Scoring", "stage": 3, "lane": 1, "kind": "process", "tool": "n8n" },
    { "id": "route", "label": "Owner Routing", "stage": 4, "lane": 1, "kind": "process", "tool": "n8n" },
    { "id": "slack", "label": "Slack Alert", "stage": 5, "lane": 0, "kind": "output", "tool": "slack" },
    { "id": "crm", "label": "HubSpot Contact", "stage": 5, "lane": 1, "kind": "store", "tool": "hubspot" },
    { "id": "ledger", "label": "Lead Record", "stage": 5, "lane": 2, "kind": "store", "tool": "postgres" }
  ],
  "edges": [
    { "id": "e1", "from": "form", "to": "webhook" },
    { "id": "e2", "from": "webhook", "to": "raw" },
    { "id": "e3", "from": "webhook", "to": "enrich" },
    { "id": "e4", "from": "enrich", "to": "score" },
    { "id": "e5", "from": "score", "to": "route" },
    { "id": "e6", "from": "route", "to": "slack" },
    { "id": "e7", "from": "route", "to": "crm" },
    { "id": "e8", "from": "score", "to": "ledger" }
  ],
  "steps": [
    {
      "id": "s1",
      "activateNodes": ["form", "webhook"],
      "activateEdges": ["e1"],
      "callout": {
        "text": "Every payload gets an idempotency key at the webhook, before anything else runs",
        "anchor": "webhook",
        "side": "top"
      }
    },
    {
      "id": "s2",
      "activateNodes": ["raw", "enrich"],
      "activateEdges": ["e2", "e3"],
      "packetPath": ["webhook", "enrich"],
      "callout": {
        "text": "The raw payload is persisted first; if enrichment fails, the lead falls back to form data and routes anyway",
        "anchor": "enrich",
        "side": "top"
      }
    },
    {
      "id": "s3",
      "activateNodes": ["score"],
      "activateEdges": ["e4"],
      "packetPath": ["enrich", "score"],
      "callout": {
        "text": "Config-driven scoring: the same input produces the same score, every run",
        "anchor": "score",
        "side": "top"
      }
    },
    {
      "id": "s4",
      "activateNodes": ["route", "slack"],
      "activateEdges": ["e5", "e6"],
      "packetPath": ["score", "route", "slack"],
      "callout": {
        "text": "Qualified leads round-robin to an owner and land in Slack with full context",
        "anchor": "slack",
        "side": "top"
      }
    },
    {
      "id": "s5",
      "activateNodes": ["crm", "ledger"],
      "activateEdges": ["e7", "e8"],
      "packetPath": ["route", "crm"],
      "callout": {
        "text": "HubSpot gets the contact by find-or-create; every lead, qualified or not, is recorded in Postgres",
        "anchor": "crm",
        "side": "bottom"
      }
    }
  ]
}

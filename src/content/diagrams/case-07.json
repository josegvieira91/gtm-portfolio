{
  "id": "case-07",
  "nodes": [
    { "id": "hs", "label": "HubSpot Event", "stage": 0, "lane": 0, "kind": "trigger", "tool": "hubspot" },
    { "id": "sfin", "label": "Salesforce Event", "stage": 0, "lane": 2, "kind": "trigger", "tool": "salesforce" },

    { "id": "map", "label": "Field Map", "stage": 2, "lane": 1, "kind": "process", "tool": "n8n" },
    { "id": "conflict", "label": "Conflict Rules", "stage": 3, "lane": 1, "kind": "process", "tool": "n8n" },
    { "id": "hsout", "label": "HubSpot Upsert", "stage": 4, "lane": 0, "kind": "store", "tool": "hubspot" },

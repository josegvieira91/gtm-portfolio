  "steps": [
    {
      "id": "s1",
      "activateNodes": ["hs", "sfin", "queue"],
      "activateEdges": ["e1", "e2"],
      "callout": {
        "text": "Change events from both CRMs land in one ordered queue, no polling",
        "anchor": "queue",
        "side": "top"
      }

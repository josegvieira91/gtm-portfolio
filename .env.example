# GTM Engineering Portfolio — local environment variables
#
# Copy this file to .env (chmod 600) and fill in the real value(s). .env is gitignored — never
# commit it, never paste its contents into chat. See scripts/seed-data/README.md for the full
# setup walkthrough.

# HubSpot private app access token, scoped to the "Vieira GTM Lab" portal.
# Created at: Settings (gear icon, top right) -> Integrations -> Private Apps -> Create a
# private app -> Scopes tab.
# Required scopes (Read + Write on both):
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.companies.read
#   crm.objects.companies.write
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Phase 3 case builds (added 2026-09-07). Keys live only in .env (chmod 600), never in git. ---
# Case 5 (AI-Personalized Outbound)
APOLLO_API_KEY=            # Apollo: Settings -> Integrations -> API, "master key" enabled
OPENAI_API_KEY=            # OpenAI platform, project-scoped key, prepaid balance, auto-recharge OFF
INSTANTLY_API_KEY=         # created only on the Case 5 run day (14-day trial clock)
INSTANTLY_CAMPAIGN_ID=
# Cases 4 and 8 (Make)
MAKE_API_TOKEN=            # Make: Profile -> API
MAKE_ZONE=                 # e.g. us2.make.com
# Case 2 (WhatsApp Cloud API) — permanent System User token, NOT the 24h test token
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
# Case 10 (PostHog + Stripe test mode)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=              # https://us.posthog.com or https://eu.posthog.com
STRIPE_TEST_SECRET_KEY=    # sk_test_... only; never a live key
